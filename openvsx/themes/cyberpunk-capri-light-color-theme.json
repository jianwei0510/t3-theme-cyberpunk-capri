{
  "name": "Cyberpunk Capri Light",
  "type": "light",
  "colors": {
    "focusBorder": "#D90B3D",
    "foreground": "#24101C",
    "descriptionForeground": "#8F1240",
    "errorForeground": "#B8410A",
    "editor.background": "#FFFFFF",
    "editor.foreground": "#24101C",
    "editorCursor.foreground": "#0B7A4B",
    "editor.selectionBackground": "#BDEDD3",
    "editor.lineHighlightBackground": "#F7F6F8",
    "editorLineNumber.foreground": "#8F124080",
    "editorLineNumber.activeForeground": "#D90B3D",
    "editorWidget.background": "#FFFFFF",
    "dropdown.background": "#FFFFFF",
    "menu.background": "#FFFFFF",
    "quickInput.background": "#FFFFFF",
    "panel.background": "#FFFFFF",
    "panel.border": "#D9D3E2",
    "editorGroup.border": "#D9D3E2",
    "input.background": "#FFFFFF",
    "input.border": "#0E8F4E",
    "input.foreground": "#24101C",
    "input.placeholderForeground": "#A8325A",
    "button.background": "#0B7A4B",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#05472C",
    "textLink.foreground": "#D90B3D",
    "badge.background": "#D90B3D",
    "badge.foreground": "#FFFFFF",
    "activityBar.background": "#F7F6F8",
    "activityBar.foreground": "#24101C",
    "activityBarBadge.background": "#D90B3D",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#F7F6F8",
    "sideBar.foreground": "#24101C",
    "sideBar.border": "#E3DFE6",
    "list.hoverBackground": "#FFEFF4",
    "list.inactiveSelectionBackground": "#FFE1EA",
    "list.activeSelectionBackground": "#FFE1EA",
    "list.activeSelectionForeground": "#24101C",
    "titleBar.activeBackground": "#FFFFFF",
    "titleBar.activeForeground": "#24101C",
    "titleBar.border": "#E3DFE6",
    "statusBar.background": "#FFFFFF",
    "statusBar.foreground": "#24101C",
    "statusBar.border": "#E3DFE6",
    "tab.activeBackground": "#FFFFFF",
    "tab.inactiveBackground": "#F7F6F8",
    "tab.activeForeground": "#24101C",
    "tab.inactiveForeground": "#8F1240",
    "tab.activeBorderTop": "#D90B3D",
    "tab.border": "#D9D3E2",
    "editorGroupHeader.tabsBackground": "#F7F6F8",
    "textCodeBlock.background": "#F0FBF5",
    "progressBar.background": "#D90B3D",
    "editorError.foreground": "#B8410A",
    "editorWarning.foreground": "#8A6A00",
    "editor.findMatchBackground": "#0B7A4B",
    "editor.findMatchForeground": "#FFFFFF",
    "editor.findMatchHighlightBackground": "#D9C8FF",
    "editor.findMatchHighlightForeground": "#24101C",
    "terminal.background": "#FFFFFF",
    "terminal.foreground": "#24101C",
    "terminalCursor.foreground": "#0B7A4B",
    "terminal.selectionBackground": "#BDEDD3",
    "scrollbarSlider.background": "#D8F5E5",
    "scrollbarSlider.hoverBackground": "#0B7A4B"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8F1240B3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#D90B3D"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#0B7A4B"
      }
    },
    {
      "name": "Number and constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#6B2FC7"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#A3154A"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#1D5FD1"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#24101C"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#D90B3D"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A3154A"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#B8410A"
      }
    }
  ]
}
